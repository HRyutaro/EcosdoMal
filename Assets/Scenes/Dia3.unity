  m_Name: 
  m_EditorClassIdentifier: 
  speechtxt:
  - "Charles: O que voc\xEA est\xE1 fazendo a\xED? N\xE3o pode brincar com o elevador!"
  - "Lisa: Mas papai! Eu s\xF3 queria descer usando ele"
  - "Charles: Des\xE7a de escada!"
  - "Lisa: N\xE3o vou, eu quero ir de elevador!"
  - "Charles: V\xE1 logo sua pestinha, n\xE3o teste a minha paci\xEAncia!"
  - "Lisa: N\xE3o vou! Eu vou descer usando o elevador, voc\xEA n\xE3o manda em mim!"
  - "Charles:  Ora sua!!! Obede\xE7a seu pai! "
  proxSprite: 0
